# ── Supabase ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Single-plan recurring Price ID (created in the Stripe dashboard for the
# £99/month subscription product). Used by lib/stripe.ts.
STRIPE_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Boost product price IDs (one-off purchases for promoting profiles/jobs).
STRIPE_BOOST_PROFILE_7_PRICE_ID=price_...
STRIPE_BOOST_PROFILE_14_PRICE_ID=price_...
STRIPE_BOOST_PROFILE_30_PRICE_ID=price_...
STRIPE_BOOST_JOB_7_PRICE_ID=price_...
STRIPE_BOOST_JOB_14_PRICE_ID=price_...
STRIPE_BOOST_JOB_30_PRICE_ID=price_...

# ── Resend (email) ────────────────────────────────────────────────────────────
RESEND_API_KEY=re_...
# Set to "true" once thrivecareer.co.uk is verified at Resend. Without it,
# emails send from onboarding@resend.dev (sandbox) and only deliver to the
# Resend account owner's verified email — see lib/email.ts.
RESEND_DOMAIN_VERIFIED=false

# ── Anthropic (AI job ad assistant) ──────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Firecrawl (company profile auto-fill) ────────────────────────────────────
FIRECRAWL_API_KEY=fc-...

# ── Google Calendar OAuth ────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_BASE_URL=https://thrivecareer.co.uk
NEXT_PUBLIC_SITE_URL=https://thrivecareer.co.uk

# ── Optional: UK address lookup ───────────────────────────────────────────────
# Street-level address lookup via Postcoder (postcoder.com)
POSTCODER_API_KEY=your-postcoder-api-key

# ── Cron jobs ─────────────────────────────────────────────────────────────────
# Required for Vercel cron job authentication. Generate a random string
# and add it to Vercel environment variables.
CRON_SECRET=your-random-cron-secret

# ── Dev mode (never set true in production) ───────────────────────────────────
# NEXT_PUBLIC_DEV_MODE=true

# ── Test fixtures ─────────────────────────────────────────────────────────────
# The password for the employer fixture (pauldavies.gbr+employer@gmail.com).
# NO EMPLOYER-SIDE DRIVE CAN RUN WITHOUT IT — its absence blocked the status
# transition log's proof on 15 Aug 2026 and nothing in the repo said it existed.
TEST_EMPLOYER_PASSWORD=
