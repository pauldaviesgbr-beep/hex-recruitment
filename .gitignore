node_modules
.next
.env.local
.env
*.log
hex-recruitment.zip
.env.test

.playwright-mcp/

# Images — ignore everywhere except intentional assets under public/ and
# the Next App Router icon conventions under app/ (favicon.ico, icon.svg,
# apple-icon.png, opengraph-image.png, etc.)
*.png
*.jpg
*.jpeg
!public/**/*.png
!public/**/*.jpg
!public/**/*.jpeg
!public/**/*.svg
!app/**/*.png

# TypeScript incremental build info
tsconfig.tsbuildinfo
*.tsbuildinfo

.vercel
.env*.local

# Per-machine Claude Code settings (permissions, etc.) — shared repo keeps
# only .claude/settings.json, which applies to the whole team.
.claude/settings.local.json
.claude/credentials.local.json
.claude/scheduled_tasks.lock
# Timestamped backups the CLI leaves behind when it rewrites settings. One got
# swept into a commit by `git add -A` on 4 Aug 2026 — it held only a permissions
# allow-list, but the same file can carry MCP definitions, so it is ignored by
# pattern rather than remembered by hand.
.claude/*.bak*

# Claude Code's own config. It normally lives in the home directory, but it
# holds MCP server definitions which can carry access tokens — so if one is
# ever created inside the repo it must not be committable.
.claude.json

# Goldenkeys import scratch (scraped data cache)
scripts/.goldenkeys/

# OAuth client secrets and tokens — must never be committed. Keep these
# outside the repo entirely.
*client_secret*.json
credentials.json
gcp-oauth.keys.json
token.json

# scratch output from npm run guard:prove
.guardproof/

# one-off codemod scratch
.surface.js
scripts/tmp-*

# Operator report — contains derived data about real candidates and the repo
# is PUBLIC. Regenerated on demand; never committed.
THRIVE-REPORT*.md
THRIVE-REPORT*.txt
